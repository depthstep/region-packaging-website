# Copy to .env.local for local dev, and add the same keys in Vercel > Project > Settings > Environment Variables.
# Leave the Sanity keys empty to preview the site from the local seed content in /content.

# Sanity (sanity.io/manage > your project)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=          # optional: only needed if the dataset is private
SANITY_API_WRITE_TOKEN=         # Editor token, server-side only. Saves quote requests + artwork to the CMS
SANITY_REVALIDATE_SECRET=       # any long random string; paste the same value into the Sanity webhook

# Quote emails (resend.com, verify your sending domain first)
RESEND_API_KEY=
QUOTE_TO_EMAIL=                 # inbox(es) that receive enquiries, comma separated
QUOTE_FROM_EMAIL=quotes@yourdomain.com

# Artwork uploads up to 15MB (Vercel > Storage > Blob). Without it, files go through the API route,
# which Vercel caps at 4.5MB per request.
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
