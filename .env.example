# Copy to .env (local) or the server's .env. Never commit the real file.
# Leave DATABASE_URI empty to preview the site from the local seed content in /content.

# Payload CMS
DATABASE_URI=file:./data/payload.db   # SQLite file; back it up together with the uploads/ folder
PAYLOAD_SECRET=                        # long random string, e.g. `openssl rand -hex 32`. Keep it private and stable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # the live URL on the server, e.g. https://www.regionpackaging.com

# Quote emails over SMTP (e.g. Hostinger email: smtp.hostinger.com, port 465).
# Without these, enquiries are still saved in the admin under Quote requests.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
QUOTE_FROM_EMAIL=quotes@yourdomain.com   # usually the same mailbox as SMTP_USER
QUOTE_TO_EMAIL=                          # inbox(es) that receive enquiries, comma separated
